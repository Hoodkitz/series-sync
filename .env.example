# --- Pflicht in Produktion ---
ENV=production
JWT_SECRET=                      # >= 32 zufällige Zeichen: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://seriessync_app:CHANGE_ME@db:5432/seriessync   # App-Rolle (nicht Owner) -> RLS greift
CORS_ORIGINS=https://app.example.com

# --- KI-Anbieter (PROVIDER_MODE=real) ---
PROVIDER_MODE=real               # fake nur mit ENV=development (lokale Demo ohne Kosten)
OPENAI_API_KEY=                  # Whisper-Transkription + Übersetzung (OpenAI-kompatibel)
OPENAI_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=              # Sprachsynthese + Stimmklone
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_DEFAULT_VOICE=pNInz6obpgDQGcFmaJgB
TTS_CONCURRENCY=4

# --- Medien ---
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=4096
MAX_DURATION_MINUTES=90
BACKGROUND_VOLUME=0.18           # Originalton (Musik/Effekte) unter der Synchronstimme, 0..1
