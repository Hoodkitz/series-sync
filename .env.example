# --- Pflicht in Produktion ---
ENV=production
JWT_SECRET=                      # >= 32 zufällige Zeichen: python -c "import secrets;print(secrets.token_urlsafe(48))"
DATABASE_URL=postgresql+asyncpg://seriessync_app:CHANGE_ME@db:5432/seriessync   # App-Rolle (nicht Owner) -> RLS greift
CORS_ORIGINS=https://app.example.com

# --- KI-Anbieter (PROVIDER_MODE=real) ---
PROVIDER_MODE=real               # fake nur mit ENV=development (lokale Demo ohne Kosten)
OPENAI_API_KEY=                  # Whisper-Transkription + Übersetzung (OpenAI-kompatibel)
OPENAI_BASE_URL=https://api.openai.com/v1
ASR_MODEL=whisper-1
LLM_MODEL=gpt-4o-mini
ELEVENLABS_API_KEY=              # Sprachsynthese + Stimmklone
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_DEFAULT_VOICE=pNInz6obpgDQGcFmaJgB
TTS_CONCURRENCY=4

# --- Medien ---
STORAGE_DIR=./var/storage
MAX_UPLOAD_MB=4096
MAX_DURATION_MINUTES=90
BACKGROUND_VOLUME=0.18           # Originalton (Musik/Effekte) unter der Synchronstimme, 0..1

# --- KI-Anbieter (PROVIDER_MODE=gemini) ---
# GEMINI_API_KEY=                   # oder ~/.secrets/gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# GEMINI_TTS_VOICE=Kore
# GEMINI_MOCK_TTS_LIMIT=10          # 0 = unbegrenzt, >0 = simulierte Free-Tier-Quote (z.B. 10/Tag)

# --- Background Worker ---
# WORKER_ENABLED=false              # true: Hintergrund-Worker nimmt pausierte/unterbrochene Jobs automatisch wieder auf
# WORKER_POLL_INTERVAL=30.0         # Abfrageintervall in Sekunden
